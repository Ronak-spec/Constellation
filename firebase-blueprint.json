{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "userId": { "type": "string", "description": "The user UID from Firebase Auth" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar URL" },
        "birthYear": { "type": "number", "description": "Year of birth for life horizon calculation" },
        "lifeExp": { "type": "number", "description": "Expected lifespan in years" },
        "wage": { "type": "number", "description": "Hourly wage for meteor appraisal" },
        "lastDate": { "type": "string", "description": "Last recorded active date (YYYY-MM-DD)" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "StarEntry": {
      "collection": "users/{userId}/entries",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier of the star entry" },
        "activity": { "type": "string", "description": "What was done" },
        "mins": { "type": "number", "description": "Duration in minutes" },
        "cat": { "type": "string", "description": "Category: Work, Chores, Connection, Rest, Joy, Scroll" },
        "time": { "type": "string", "description": "Time string of logging" },
        "createdAt": { "type": "number", "description": "Timestamp in milliseconds" }
      }
    },
    "UnlitTask": {
      "collection": "users/{userId}/tasks",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier of the unlit task" },
        "text": { "type": "string", "description": "Intention or star waiting to be earned" },
        "cat": { "type": "string", "description": "Category" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "fromUnderstory": { "type": "boolean", "description": "Whether surfaced from the understory" }
      }
    },
    "MeteorSub": {
      "collection": "users/{userId}/subs",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier of the subscription" },
        "name": { "type": "string", "description": "Subscription name" },
        "cost": { "type": "number", "description": "Monthly cost in dollars" },
        "kept": { "type": "boolean", "description": "Whether kept on purpose as a beacon" }
      }
    },
    "ArchivedNight": {
      "collection": "users/{userId}/archive",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier / date" },
        "date": { "type": "string", "description": "Date of the closed sky (YYYY-MM-DD)" },
        "name": { "type": "string", "description": "Constellation archetype name" },
        "entries": { "type": "array", "description": "Array of star entries in this closed sky" },
        "closedAt": { "type": "number", "description": "Timestamp when closed" }
      }
    },
    "UnderstoryThought": {
      "collection": "users/{userId}/understory",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier of the buried thought" },
        "text": { "type": "string", "description": "Content of the buried thought" },
        "ts": { "type": "number", "description": "Timestamp when buried" }
      }
    }
  }
}
